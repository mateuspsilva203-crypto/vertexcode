# Copie este arquivo para ".env" e ajuste os valores.
# (No Windows: copy .env.example .env)

# Porta do servidor
PORT=3000

# Senha para ver os leads em /admin.html (TROQUE por algo longo e secreto)
ADMIN_TOKEN=troque-esta-senha-por-uma-bem-grande

# Domínios autorizados a enviar o formulário, separados por vírgula.
# Se o site e a API rodam juntos (npm start), pode deixar vazio.
# Exemplo: https://vertexcode.com.br,https://www.vertexcode.com.br
ALLOWED_ORIGINS=

# Caminho do arquivo do banco (padrão: ./data/leads.db)
DB_PATH=./data/leads.db
